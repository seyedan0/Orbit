# Database connection
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/orbit
# Or individual connection variables:
# DB_HOST=localhost
# DB_PORT=5432
# DB_USERNAME=postgres
# DB_PASSWORD=postgres
# DB_DATABASE=orbit
# DB_SSL=false

# Authentication (JWT)
# Required when NODE_ENV=production (min 32 chars). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# If unset outside production, a random per-process secret is used and all
# tokens become invalid whenever the server restarts.
# JWT_SECRET=
# Access token lifetime in seconds (default 604800 = 7 days)
# JWT_EXPIRES_IN_SECONDS=604800
