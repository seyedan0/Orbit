{
  "name": "orbit",
  "version": "0.1.0",
  "private": true,
  "description": "Offline-first task platform for desktop and Android",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "tsc --build && npm run typecheck --workspace @orbit/web",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
